# Rust and TypeScript
target
node_modules

# Builds and generated outputs never enter git: forge renders, world bakes, web builds, the desktop app's build and
# installers.
dist/
desktop/out/
generated
client/public/*.wasm
# The island build's packs, copied in for pictures before they are published (the editor's ?islePacks=).
client/public/isle-packs/
# The forge's renders, its tables and its packs: published to R2 by tools/forge_publish.py.
tools/forge/public/
tools/forge/src/systems/
tools/forge/packs/
# A render's lock on its keys (rendercache.py), held only while it runs.
tools/forge/tools/sprite-forge/keys/*.lock
__pycache__/

# The toolkit's working folders: the code map it generates and Serena's project data.
graphify-out/
.serena/

# Local
*.log
.DS_Store
.env
.env.*
.idea/
.vscode/

# Obsidian: personal layout and caches stay local; the shared settings are committed.
bible/.obsidian/workspace.json
bible/.obsidian/workspace-mobile.json
bible/.obsidian/graph.json
bible/.obsidian/plugins/
bible/.obsidian/themes/
bible/.trash/

# Worktrees the coding tools make for their helpers.
.claude/worktrees/
# Cloudflare's local runtime keeps its rooms' state and logs here while `npm run server` runs.
.wrangler/

# The design tool's own working folder (its live server and saved critiques), never the repo's.
.impeccable/
