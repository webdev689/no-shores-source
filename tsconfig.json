{
  // The client: strict from the first line, DOM types, no Node types (the game never touches Node in the browser).
  // Only erasable syntax, so Node runs the tests' TypeScript directly with no build step.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["client/**/*.ts"],
  "exclude": ["client/**/*.test.ts", "node_modules", "dist"]
}
