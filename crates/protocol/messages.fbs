// Every message between a browser and a room, defined once: flatc makes the Rust and the TypeScript from this file.
// A body and controls cross as the movement crate's numbers, in its order (crates/movement/src/floats.rs), the same
// order the browser's WebAssembly door uses. New fields go at the end of their table, so old readers skip them.

namespace overlook.wire;

// A browser's controls for one tick: forward, sideways, yaw, run, jump, crouch, mounted. Numbered 1, 2, 3 and so on.
// With them, what the player's figure shows on their own screen (the forge's move, its frame, the way it faces),
// their dress, as the browser writes it, only when it changed, and whether they ask to respawn.
table Input {
  sequence: uint;
  controls: [double];
  anim: string;
  frame: ushort;
  facing: double;
  dress: string;
  respawn: bool;
}

// A ship's course in the sea room: the world points it sails through in turn, x then y in metres, and its pace, one
// of the steps of a ship's speed. A ship not yet at sea puts to sea at the first point; no points brings it to rest.
table Course {
  points: [double];
  pace: ushort;
}

// A player's dress, passed on as their browser wrote it.
table Dressed {
  player: uint;
  dress: string;
}

// The room's welcome: the joining player's number, everyone's dress so far, and in a node's room the node's id and
// the rect its ground is cut to (west, north, east, south), for the browser to cut the same.
table Joined {
  player: uint;
  dressed: [Dressed];
  node: string;
  bounds: [double];
}

// One player as the room last stepped them: their body's 22 numbers, the number of their last input it took, what
// their figure showed with it, and where they stand with the section: 0 inside it or on its edge, 1 outside and
// warned to go back, with the ticks left, 2 dead, with the ticks since. A number, not a schema enum, so the
// TypeScript flatc makes stays erasable.
table Seen {
  player: uint;
  acknowledged: uint;
  body: [double];
  anim: string;
  frame: ushort;
  facing: double;
  standing: ubyte;
  standing_ticks: uint;
}

// One ship as the sea room last moved it: where it is, its heading in radians clockwise from north, and its pace, 0
// at rest.
table Ship {
  player: uint;
  x: double;
  y: double;
  heading: double;
  pace: ushort;
}

// Every player in the room after one of its ticks, and the dresses that changed since the last snapshot; in the sea
// room, every ship at sea.
table Snapshot {
  tick: ulong;
  players: [Seen];
  dressed: [Dressed];
  ships: [Ship];
}

// What a room sends: exactly one of these is present.
table FromRoom {
  joined: Joined;
  snapshot: Snapshot;
}

root_type FromRoom;
