// Every message between a browser and a room, defined once: flatc makes the Rust and the TypeScript from this file.
// A body and controls cross as the movement crate's numbers, in its order (crates/movement/src/floats.rs), the same
// order the browser's WebAssembly door uses. New fields go at the end of their table, so old readers skip them.

namespace overlook.wire;

// A player's ask of their gear, carried by one input: what (as the room numbers it), and what it names: an item or a
// Vestige by the player's own number for it, a slot, a node's column and place in it, and for the Test Ground's
// grants a rarity, a level, a count, a kind of item and a named item's id.
table Ask {
  kind: ubyte;
  item: uint;
  slot: ubyte;
  column: ubyte;
  node: ubyte;
  rarity: ubyte;
  level: ubyte;
  count: uint;
  item_kind: ubyte;
  named: string;
}

// A browser's controls for one tick: forward, sideways, yaw, run, jump, crouch, mounted. Numbered 1, 2, 3 and so on.
// With them, what the player's figure shows on their own screen (the forge's move, its frame, the way it faces), and
// their dress, as the browser writes it, only when it changed. Then the fight's buttons (the stroke a swing would take,
// 0 for none and 1 to 6 as combat numbers them; guard, dodge and shoot held; the look's pitch), what the hands hold as
// combat's arms code, the room tick of the last snapshot the screen showed, a foe to stand before the player (0 none;
// 255 sends every foe away; else its role, 1 to 5, in the low four bits when no type is named, and the element of a
// shield it stands with in the bits above them), whether they ask to respawn, dead past a node's section, an ask of
// their gear, and the level of the foe asked for (0 for none: combat's own numbers). Then the foe's type's number in
// the roster (0 none) and its rank (1 Minor to 5 Boss; one the type does not come in takes the type's first). Then a
// spell cast this tick, by its number among the Arts' (1 Tempest to 9 Vanish, 0 none), and where it is aimed (x, y,
// z): Dusk Daggers' ring while it is held and as it is let go. New fields go at the end, so old readers skip them.
table Input {
  sequence: uint;
  controls: [double];
  anim: string;
  frame: ushort;
  facing: double;
  dress: string;
  combat: [double];
  arms: uint;
  seen: ulong;
  spawn: ubyte;
  respawn: bool;
  ask: Ask;
  spawn_level: ubyte;
  spawn_type: ubyte;
  spawn_rank: ubyte;
  cast: ubyte;
  cast_aim: [double];
}

// A ship's course in the sea room: the world points it sails through in turn, x then y in metres, and its pace, one
// of the steps of a ship's speed. A ship not yet at sea puts to sea at the first point; no points brings it to rest,
// turned to `facing` when it holds one heading (radians clockwise from north).
// In a fight, her orders instead, in the naval crate's numbers (crates/naval/src/wire.rs), and no points. Off the
// helm, a step of the player's walk on her deck instead: its controls in the movement crate's order and its number,
// 1, 2, 3 and so on from the helm left. Or the helm left (1), or taken again at the wheel (2), or a chase (3): the
// hostile ship she chases by her number, `chase`, 0 for none. Or an ask: her repair by a port city (1), to board a
// captain who struck (2), or to leave her deck once her crew has fallen (3).
table Course {
  points: [double];
  pace: ushort;
  orders: [double];
  walk: [double];
  walk_sequence: uint;
  helm: ubyte;
  facing: [double];
  chase: uint;
  ask: ubyte;
}

// A piece of what floats at sea, kept for one player: theirs, its number, where it floats (x, y in metres) and what it
// looks like (0 a crate, 1 a barrel, 2 a chest).
table Flotsam {
  player: uint;
  id: uint;
  x: double;
  y: double;
  kind: ubyte;
}

// A player's ship's hurts as the sea keeps them: the shares of her hull, canvas and men she has, and the seconds her
// repair has left (0 with none under way).
table Kept {
  player: uint;
  hull: double;
  sail: double;
  crew: double;
  repair_left: double;
}

// A captain's deck that players boarded: each boarder's number at sea and in turn their number on her deck, her hull
// (as Pirate numbers it), her deck room's own snapshot (a FromRoom message of a room on land, in her own frame), and
// the sea's ticks her won deck holds her boarders yet (-1 while her crew still fights).
table Deck {
  players: [uint];
  boarders: [uint];
  hull: ubyte;
  snapshot: [ubyte];
  hold_left: short = -1;
}

// What the sea tells one player this tick beside their fight's view: one event in the naval crate's numbers
// (crates/naval/src/wire.rs: what floats laid, gathered, a boarding), or the sea's own (crates/room/src/harbour.rs:
// washed up, what a piece held).
table Told {
  player: uint;
  numbers: [double];
}

// A player's orders for one tick in a fleet room, numbered 1, 2, 3 and so on: her helm (the rudder from -1, to port,
// to 1, to starboard; whether her oars pull her sideways; a rung up the ladder, 1, or down, -1, for one tick); her look
// while she aims (its bearing off her bow in degrees and how far out it meets the water in metres, then its ray: the
// aim eye and the way it looks, east, south and up; none while she does not aim); whether she fires and whether she
// braces; a load to take (0 none, 1 round, 2 grape, 3 chain, 4 heated); where she puts to sea (x, y and heading,
// heeded once); a captain asked for (0 none, 1 one called round her, 255 every one sent off); and the faction (1 the
// Grey Tithe, 2 pirates) and rank (1 Minor to 5 Boss) of the one called, 0 for a Major of the pirates.
table Orders {
  sequence: uint;
  steer: double;
  crab: bool;
  climb: byte;
  aim: [double];
  fire: bool;
  brace: bool;
  load: ubyte;
  put_to_sea: [double];
  call: ubyte;
  call_faction: ubyte;
  call_rank: ubyte;
}

// A player's dress, passed on as their browser wrote it.
table Dressed {
  player: uint;
  dress: string;
}

// The room's welcome: the joining player's number, everyone's dress so far, and in a node's room the node's id and
// the rect its ground is cut to (west, north, east, south), for the browser to cut the same.
table Joined {
  player: uint;
  dressed: [Dressed];
  node: string;
  bounds: [double];
  // The protocol's version: the schema's hash, so a page built from another schema knows to load again.
  protocol: uint;
}

// One player as the room last stepped them: the number of their last input it took, what their figure showed with
// it, their whole fighter in combat's order (crates/combat/src/floats.rs), whose first 22 numbers are its body and
// whose statuses (each one's ticks left, a Veiled player's among them) follow its action's numbers, and where they
// stand with a node's section: 0 inside it or on its edge, 1 outside and warned to go back, with the ticks left, 2
// dead, with the ticks since. A number, not a schema enum, so the TypeScript flatc makes stays erasable.
table Seen {
  player: uint;
  acknowledged: uint;
  body: [double] (deprecated);
  anim: string;
  frame: ushort;
  facing: double;
  fighter: [double];
  standing: ubyte;
  standing_ticks: uint;
}

// A foe as the room last stepped it: its number, its role (1 skirmisher, 2 swordsman, 3 brute, 4 archer, 5 captain), a
// glance at its fighter (combat's glance order), its level, and its shield, if it stands with one: its element (the
// gear crate's numbers, 0 for none), what it holds still and what it held whole. Then its type's number in the roster,
// its rank (1 Minor to 5 Boss), its faction's number, the phase it fights in (1, 2 or 3), and how alert it is (0 idle,
// 1 suspicious, 2 alert, 3 searching). Then the ticks left of its Expose and its Charge, and of the immunity a Charge
// leaves after it.
table Foe {
  id: uint;
  kind: ubyte;
  glance: [double];
  level: ubyte;
  shield_element: ubyte;
  shield: double;
  shield_most: double;
  type: ubyte;
  rank: ubyte;
  faction: ubyte;
  phase: ubyte;
  alert: ubyte;
  expose: uint;
  charge: uint;
  charge_immune: uint;
}

// Something that happened in the fight: what (as the room numbers it), how the blow was struck (0 for none), who struck
// and who was struck, how much it did, the stroke a swing came by (combat's 1 to 6, 0 for none), whether the blow was
// a crit, and the element it carried (the gear's 1 to 3, 0 for none).
table Event {
  tick: ulong;
  kind: ubyte;
  how: ubyte;
  striker: uint;
  defender: uint;
  amount: double;
  stroke: ubyte;
  crit: bool;
  element: ubyte;
}

// A shot in flight, or a gun's ball in the tick it stopped: who shot it, what shot it (combat's number), where it is
// (x, y, z), how fast it goes, and the ticks it has flown. A stopped ball's last segment runs from `at` to `at` plus
// one tick of its velocity, to where it stopped, and carries `muzzle`, the point it left its gun; a ball still flying
// carries none.
table Flying {
  owner: uint;
  ranged: ubyte;
  at: [double];
  velocity: [double];
  age: ushort;
  muzzle: [double];
}

// One ship as the sea room last moved it: where it is, its heading in radians clockwise from north, and the pace it
// sailed at, held down near a pirate, 0 at rest.
table Ship {
  player: uint;
  x: double;
  y: double;
  heading: double;
  pace: ushort;
}

// A captain's ship at sea, a pirate's or the Grey Tithe's: her number, where she is, her heading in radians clockwise
// from north, her faction (1 the Grey Tithe, 2 pirates), her rank (1 Minor to 5 Boss) and the hull her rank sails (0
// the Sloop, 1 the Schooner, 2 the Brig, 3 the Frigate; a reader that knows none reads the Sloop); then her level (0
// none), the distance she is sighted from, metres (0 from a room that sends none), and her way at sea, metres a second
// at the world's own time (0 from a room that sends none).
table Pirate {
  id: uint;
  x: double;
  y: double;
  heading: double;
  faction: ubyte;
  rank: ubyte;
  hull: ubyte;
  level: ubyte;
  sight: double;
  way: double;
}

// A player's fight at sea as the room last stepped it, in the naval crate's numbers (crates/naval/src/wire.rs), and
// her captain's faction, rank and hull, as Pirate numbers them. Then the other captains in the fight, their count and
// each one's numbers (the number her events name her by, her faction and rank, her ship and her mind; none when
// there are none), which the view leaves out so a page that knows one captain reads it whole.
table SeaFight {
  player: uint;
  view: [double];
  faction: ubyte;
  rank: ubyte;
  others: [double];
  hull: ubyte;
}

// One ship in a fleet room: her number; whether a captain sails her; her helm's numbers in the sailing crate's order
// (crates/sailing/src/floats.rs) and her pose; her hull, sail and men, each with what she has of it whole; her state
// (0 afloat, 1 struck, 2 sinking, 3 sunk, 4 wrecked) and the fires aboard; her guns (the seconds each side has left
// to load, port then starboard, then how far each has loaded); her load (as Orders numbers it) and whether she is
// braced; for a captain, her mode (0 cruise, 1 engage, 2 flee, 3 struck, 4 sinking), the ship she fights (0 none) and
// her sides run out (1 port, 2 starboard, 3 both); for a player's ship, the number of her last orders taken; and the
// faction she sails for (0 a player's, else as Pirate numbers them), a captain's rank (1 Minor to 5 Boss, 0 none), and
// her hull, as Pirate numbers them.
table Vessel {
  id: uint;
  captain: bool;
  ship: [double];
  pose: [double];
  hurts: [double];
  state: ubyte;
  fires: ubyte;
  guns: [double];
  load: ubyte;
  braced: bool;
  mode: ubyte;
  target: uint;
  run_out: ubyte;
  acknowledged: uint;
  faction: ubyte;
  rank: ubyte;
  hull: ubyte;
}

// A ball aloft in a fleet room: the ship that fired it, where it leaves its gun and when (seconds of the fight's
// clock), its launch velocity, and its radius. It flies by its closed form: at t seconds it is start plus launch times
// t, less half of 9.81 m/s² times t squared upward.
table Ball {
  shooter: uint;
  start: [double];
  launch: [double];
  born: double;
  radius: double;
}

// Something that happened in a fleet room's fight, with its tick: what (1 a ball leaves its gun, 2 a ball strikes a
// ship, 3 splashes, 4 lands, 5 a captain runs out a side, 6 a ship's state changes, 7 a player's guns refuse, 8 her
// sails will not set, 9 she takes a load, 10 a captain leaves the fight, 11 a player's stem rams a ship); the ship it
// happened to (for a ball, the one that fired it, for a strike or a ram the one struck) and, for a strike or a ram,
// who struck; a number saying more (a strike's zone, 0 hull, 1 holed, 2 canvas; a side, 0 port, 1 starboard; a state
// as Vessel numbers it; why guns refuse, 0 no side bears, 1 silent, 2 braced, 3 loading; a load as Orders numbers it;
// 1 for a wreck's sails; how a captain left, 0 sunk, 1 sailed off); the side still loading; a point, and a ball's
// launch; and the seconds that side has left to load, or the hull a ram took.
table Naval {
  tick: ulong;
  kind: ubyte;
  ship: uint;
  by: uint;
  detail: ubyte;
  side: ubyte;
  point: [double];
  launch: [double];
  left: double;
}

// A spell every player sees: its number in the room; its kind (its spell's number among the Arts', 1 Tempest's orb to
// 9 Vanish's veil, 10 a Duskraven's bolt); the player who cast it; its Art (1 Storm, 2 Divine, 3 Shadow); where it is
// (x, y, z); where it heads (a Dawnflare's end, Arc Lash's reach ahead; none for the rest); the foe it seeks (0 none);
// the ticks it has lasted and its whole life in ticks; and how far it reaches (a ring's or a well's radius, a cone's
// length).
table Spell {
  id: uint;
  kind: ubyte;
  caster: uint;
  art: ubyte;
  at: [double];
  heads: [double];
  seeks: uint;
  age: uint;
  life: uint;
  radius: double;
}

// Every player in the room after one of its ticks, the dresses that changed since the last snapshot, every foe, what
// happened in the fight since the last snapshot, and the shots in flight; in the sea room, every ship at sea, every
// pirate, each player's fight, and as `players` each player off the helm, their fighter only their body on her deck in
// her own frame (x to her starboard, y to her stern, z over her waterline); in a fleet room, every ship, the balls
// aloft, what happened in its fight since the last snapshot, and the fight's clock. Then every spell in a room on land;
// and at sea what floats for each player, each player's ship's kept hurts, what each player is told this tick, and
// each deck boarded; and in a fleet room the world time its clock started at, seconds since the Unix epoch, which sets
// its weather.
table Snapshot {
  tick: ulong;
  players: [Seen];
  dressed: [Dressed];
  foes: [Foe];
  events: [Event];
  shots: [Flying];
  ships: [Ship];
  pirates: [Pirate];
  fights: [SeaFight];
  vessels: [Vessel];
  balls: [Ball];
  naval: [Naval];
  fight_clock: double;
  spells: [Spell];
  flotsam: [Flotsam];
  kept: [Kept];
  told: [Told];
  decks: [Deck];
  world_start: double;
}

// One column of an item's nodes: what it holds (0 an upgrade, 1 handling, 2 finish, 3 perks, 4 an Atheric's own), the
// traits it offers by id, the XP that unlocks it, and what a node of it costs in Aurem, fragments, Essence and the
// item's island resource.
table GearColumn {
  kind: ubyte;
  traits: [string];
  xp: uint;
  aurem: uint;
  fragments: ushort;
  essence: ushort;
  resource: ushort;
}

// An item a player holds, as their own gear message tells them: their number for it, its kind and rarity (the gear
// crate's numbers), its level, the named item it is (empty for a rolled one) or a rolled one's name among its kind's,
// its island resource (255 for none), whether a Breach's, its XP and the most it earns, the nodes bought (a bit each)
// and the one chosen in each column (255 none), the slot it is carried with, where it is (0 carried, 1 the vault, 2
// and on worn in the slot that many less 2), its Attack, Defense and Prestige, its columns, its price at a vendor, and
// a weapon's element (the gear crate's numbers, 0 for none).
table GearItem {
  id: uint;
  kind: ubyte;
  rarity: ubyte;
  level: ubyte;
  named: string;
  name: ubyte;
  resource: ubyte;
  breach: bool;
  xp: uint;
  xp_most: uint;
  bought: uint;
  chosen: [ubyte];
  bucket: ubyte;
  at: ubyte;
  attack: uint;
  defense: uint;
  prestige: uint;
  columns: [GearColumn];
  price: uint;
  element: ubyte;
}

// A Vestige a player holds: their number for it, its colour, the slot it holds an item for, that item's level, and
// whether it is in the vault.
table GearVestige {
  id: uint;
  rarity: ubyte;
  slot: ubyte;
  level: ubyte;
  vaulted: bool;
}

// A drop lying on the ground for this player alone: their number for it, a Vestige's colour and slot, and where it
// lies (x, y, z); then what it is (0 a Vestige, 1 an Ammo box, 2 an Ammo crate), where it was thrown from (x, y, z)
// and how many ticks it has still to fly before it rests.
table GearDrop {
  id: uint;
  rarity: ubyte;
  slot: ubyte;
  at: [double];
  kind: ubyte;
  from: [double];
  flying: ubyte;
}

// A player's own gear, sent to them alone whenever it changes: their XP, level, Prestige and Defense; their Aurem,
// then their Weapon and Armor Fragments, Weapon and Armor Essence and Fruit of Dagon, and each island's resource in
// the catalogue's order; their items, Vestiges and those lying for them; the room's resource nodes they have spent;
// whether they stand where a Vestige opens (the Reader's counter, or the stall); and the answer to their last ask (0 done, then the
// gear crate's refusals by number) with the item a Vestige last opened to (0 none) and how many asks have been
// answered; and the resource nodes standing that they may still gather, four numbers each: its number, x, y and its
// island's resource; and in a social space, the vendors' wares of the day, the Quartermaster's then the Armsmith's,
// each numbered by its place among its vendor's and priced in Aurem.
table Gear {
  xp: ulong;
  level: ubyte;
  prestige: uint;
  defense: uint;
  aurem: uint;
  stocks: [ushort];
  resources: [ushort];
  items: [GearItem];
  vestiges: [GearVestige];
  drops: [GearDrop];
  spent: [ubyte];
  at_reader: bool;
  answer: ubyte;
  identified: uint;
  answered: uint;
  nodes: [double];
  wares: [GearItem];
  // What their worn gear trims of the fight's numbers (combat's Trim, in its order): their fighter in a snapshot
  // leaves it out, and their browser puts it back before it predicts them.
  trim: [double];
  // How far to their next level, 0 to 1, and what it still takes: XP below level 20, Prestige past it.
  to_next: double;
  to_next_needs: uint;
  // How far their next Fruit of Dagon has grown, 0 to 1; below 0 until their XP reaches level 20's.
  fruit_growing: double = -1;
  // The arms the room lets them take up, by combat's codes: their gear's, and with a torch where the main hand
  // leaves the left free. The room makes any other bare hands.
  arms: [uint];
  // The emblems they keep and the one they wear, by their place in content/gear/emblems.json; and in a social space,
  // the emblems the Tailor sells that day.
  emblems: [ushort];
  emblem: ushort;
  emblems_sold: [ushort];
  // The Art they wear (1 Storm, 2 Divine, 3 Shadow); each Art's Core, three slots an Art in the Arts' order, each its
  // fragment's place in its Art's list (255 none); how far their Anima has charged, and each Tenet recharged, 0 to 1
  // (1 ready), as the room's tick that sent them had it.
  art: ubyte;
  cores: [ubyte];
  anima: double;
  tenets: [double];
  // The Ranged loadout's ammunition: the shots left in the one worn and its capacity (0 with none worn), and the share
  // of a full capacity kept, 0 to 1, which any Ranged weapon worn holds. Then the Ammo crates carried, and in a social
  // space the Quartermaster's price for one (0 elsewhere).
  ammo: ushort;
  ammo_most: ushort;
  ammo_share: double;
  crates: ubyte;
  crate_price: uint;
  ship: GearShip;
}

// A named officer: their number, post (0 First Mate, 1 Gunner, 2 Bosun, 3 Carpenter, 4 Lookout), grade (a rarity),
// names by their places in content/gear/crew.json, duty (0 aboard, 1 at their post, 2 ashore), level and how far to
// the next, service and its most, how well they hold their post, their nodes as an item's (each column's XP their
// service's), and an offer's wage.
table GearOfficer {
  id: uint;
  post: ubyte;
  grade: ubyte;
  given: ubyte;
  family: ubyte;
  duty: ubyte;
  level: ubyte;
  to_next: double;
  trained: uint;
  trained_most: uint;
  strength: double;
  bought: uint;
  chosen: [ubyte];
  columns: [GearColumn];
  wage: uint;
}

// The ship's own power and crew: her experience, level, Prestige, Attack and Defense and how far to her next level;
// Timber, Canvas, Iron and Heartwood; her hands and her complement; her officers, and at a pledged faction's counter
// the officers of the day; her trim at sea (the gear crate's ShipTrim, in its order); and the pledge.
table GearShip {
  xp: ulong;
  level: ubyte;
  prestige: uint;
  attack: uint;
  defense: uint;
  to_next: double;
  to_next_needs: uint;
  stocks: [ushort];
  hands: ushort;
  hands_most: ushort;
  officers: [GearOfficer];
  offers: [GearOfficer];
  trim: [double];
  // The faction the player is pledged to (0 none), whose counter signs officers on.
  pledge: ubyte;
}

// What a room sends: exactly one of these is present.
table FromRoom {
  joined: Joined;
  snapshot: Snapshot;
  gear: Gear;
}

root_type FromRoom;
