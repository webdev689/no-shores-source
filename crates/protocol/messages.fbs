// Every message between a browser and a room, defined once: flatc makes the Rust and the TypeScript from this file
// and the one it includes, a player's gear (`gear.fbs`).
// A body and controls cross as the movement crate's numbers, in its order (crates/movement/src/floats.rs), the same
// order the browser's WebAssembly door uses. New fields go at the end of their table, so old readers skip them.

include "gear.fbs";

namespace overlook.wire;

// A player's ask of their gear, carried by one input: what (as the room numbers it), and what it names: an item or a
// Vestige by the player's own number for it, a slot, a node's column and place in it, and for the Test Ground's
// grants a rarity, a level, a count, a kind of item and a named item's id.
table Ask {
  kind: ubyte;
  item: uint;
  slot: ubyte;
  column: ubyte;
  node: ubyte;
  rarity: ubyte;
  level: ubyte;
  count: uint;
  item_kind: ubyte;
  named: string;
}

// A browser's controls for one tick: forward, sideways, yaw, run, jump, crouch, mounted. Numbered 1, 2, 3 and so on.
// With them, what the player's figure shows on their own screen (the forge's move, its frame, the way it faces), and
// their dress, as the browser writes it, only when it changed. Then the fight's buttons (the stroke a swing would take,
// 0 for none and 1 to 6 as combat numbers them; guard, dodge and shoot held; the look's pitch; a ranged weapon aimed;
// the point an aimed shot is laid on; a drink asked: combat's intent order), what the hands hold as
// combat's arms code, the room tick of the last snapshot the screen showed, a foe to stand before the player (0 none;
// 255 sends every foe away; else its role, 1 to 5, in the low four bits when no type is named, and the element of a
// shield it stands with in the bits above them), whether they ask to respawn, dead past a node's section, an ask of
// their gear, and the level of the foe asked for (0 for none: combat's own numbers). Then the foe's type's number in
// the roster (0 none) and its rank (1 Minor to 5 Boss; one the type does not come in takes the type's first). Then a
// spell cast this tick, by its number among the Arts' (1 Tempest to 9 Vanish, 0 none), and where it is aimed (x, y,
// z): Dusk Daggers' ring while it is held and as it is let go. New fields go at the end, so old readers skip them.
table Input {
  sequence: uint;
  controls: [double];
  anim: string;
  frame: ushort;
  facing: double;
  dress: string;
  combat: [double];
  arms: uint;
  seen: ulong;
  spawn: ubyte;
  respawn: bool;
  ask: Ask;
  spawn_level: ubyte;
  spawn_type: ubyte;
  spawn_rank: ubyte;
  cast: ubyte;
  cast_aim: [double];
  // The inputs before it that the room has not yet shown taken, oldest first, so one lost on the way is taken from
  // the next to arrive; the room takes only those it has not had.
  earlier: [Input];
  // Whether a menu is open on the player's screen, which others see over their head.
  menu: bool;
}

// A ship's course in the sea room: the world points it sails through in turn, x then y in metres, and its pace, one of
// the steps of a ship's speed. A ship not yet at sea puts to sea at the first point; no points brings it to rest,
// turned to `facing` when it holds one heading (radians clockwise from north). In a fight, the ship's orders instead,
// in the naval crate's numbers (crates/naval/src/wire.rs), and no points. Off the helm, a step of the player's walk on
// its deck instead: its controls in the movement crate's order and its number, 1, 2, 3 and so on from the helm left. Or
// the helm left (1), or taken again at the wheel (2), or a chase (3): the hostile ship it chases by that ship's number,
// `chase`, 0 for none. Or an ask: its repair by a port city (1), to board a captain who struck (2), or to leave the
// captain's deck once its crew has fallen (3). A course asked with `travel` takes the ship to other waters by the held
// map (crates/room/src/sea_travel.rs).
table Course {
  points: [double];
  pace: ushort;
  orders: [double];
  walk: [double];
  walk_sequence: uint;
  helm: ubyte;
  facing: [double];
  chase: uint;
  ask: ubyte;
  travel: bool;
}

// A piece of what floats at sea, kept for one player: theirs, its number, where it floats (x, y in metres) and what it
// looks like (0 a crate, 1 a barrel, 2 a chest).
table Flotsam {
  player: uint;
  id: uint;
  x: double;
  y: double;
  kind: ubyte;
}

// A sea island a player sees from their ship or has found: its number, its seed, where its middle is (x, y in metres),
// its kind (0 a cove, 1 a ruin, 2 a quarry), the index in the layout of the continent whose water it lies in, and
// whether that player has found it.
table Isle {
  id: uint;
  seed: ulong;
  x: double;
  y: double;
  kind: ubyte;
  continent: ubyte;
  found: bool;
}

// A player's ship's hurts as the sea keeps them: the shares of its hull, canvas and men it has, and the seconds its
// repair has left (0 with none under way).
table Kept {
  player: uint;
  hull: double;
  sail: double;
  crew: double;
  repair_left: double;
}

// A captain's deck that players boarded: each boarder's number at sea and in turn their number on its deck, its hull
// (as Hostile numbers it), its deck room's own snapshot (a FromRoom message of a room on land, in its own frame), and
// the sea's ticks its won deck holds its boarders yet (-1 while its crew still fights).
table Deck {
  players: [uint];
  boarders: [uint];
  hull: ubyte;
  snapshot: [ubyte];
  hold_left: short = -1;
}

// What the sea tells one player this tick beside their fight's view: one event in the naval crate's numbers
// (crates/naval/src/wire.rs: what floats laid, gathered, a boarding), or the sea's own (crates/room/src/harbour.rs:
// washed up, what a piece held).
table Told {
  player: uint;
  numbers: [double];
}

// A player's orders for one tick in a fleet room, numbered 1, 2, 3 and so on: the ship's helm (the rudder from -1, to
// port, to 1, to starboard; a rung up the ladder, 1, or down, -1, for one tick); the
// player's look while they aim (its bearing off the bow in degrees and how far out it meets the water in metres, then
// its ray: the aim eye and the way it looks, east, south and up; none while they do not aim); whether the ship fires
// and whether it braces; a load to take (0 none, 1 round, 2 grape, 3 chain, 4 heated); where it puts to sea (x, y and
// heading, heeded once); a captain asked for (0 none, 1 one called round the ship, 255 every one sent off); the faction
// (1 the Grey Tithe) and rank (1 Minor to 5 Boss) of the one called, 0 for a Major of the Grey Tithe; and with a call,
// the captain's level and the caller's ship's level (0 for none: a ship unfitted).
table Orders {
  sequence: uint;
  steer: double;
  climb: byte;
  aim: [double];
  fire: bool;
  brace: bool;
  load: ubyte;
  put_to_sea: [double];
  call: ubyte;
  call_faction: ubyte;
  call_rank: ubyte;
  call_level: ubyte;
  ship_level: ubyte;
}

// A player's dress, passed on as their browser wrote it.
table Dressed {
  player: uint;
  dress: string;
}

// What others read over a player's head: their username (none for a guest), their level, and whether a menu is open
// on their screen.
table Plate {
  player: uint;
  name: string;
  level: ubyte;
  menu: bool;
}

// The room's welcome: the joining player's number, everyone's dress so far, and in a node's room the node's id and
// the rect its ground is cut to (west, north, east, south), for the browser to cut the same.
table Joined {
  player: uint;
  dressed: [Dressed];
  node: string;
  bounds: [double];
  // The protocol's version: the schema's hash, so a page built from another schema knows to load again.
  protocol: uint;
  // World time at the room's first tick, seconds: a tick's world time is this and its ticks' seconds, which the
  // room's weather is read at and a browser's prediction reads it at too.
  epoch: double;
  // Everyone's plate so far.
  plates: [Plate];
}

// One player as the room last stepped them: the number of their last input it took, what their figure showed with
// it, their whole fighter in combat's order (crates/combat/src/floats.rs), whose first 22 numbers are its body and
// whose statuses (each one's ticks left, a Veiled player's among them) follow its action's numbers, and where they
// stand with a node's section: 0 inside it or on its edge, 1 outside and warned to go back, with the ticks left, 2
// dead by straying, 3 dead by a fall in a social space, each with the ticks since. A number, not a schema enum, so the
// TypeScript flatc makes stays erasable. The player the snapshot is for has their fighter whole (`fighter`); everyone
// else's is `packed` (crates/protocol/src/pack.rs).
table Seen {
  player: uint;
  acknowledged: uint;
  body: [double] (deprecated);
  anim: string;
  frame: ushort;
  facing: double;
  fighter: [double];
  standing: ubyte;
  standing_ticks: uint;
  packed: [ubyte];
  // In a snapshot built on another that held this player, only the numbers that changed since go, a bit set here for
  // each (the first number's the lowest bit of the first byte): whole in `fighter` for the player it is for, packed
  // in `packed` for everyone else.
  changed: [ubyte];
}

// A foe as the room last stepped it: its number, its role (1 skirmisher, 2 swordsman, 3 brute, 4 archer, 5 captain), a
// glance at its fighter (combat's glance order), its level, and its shield, if it stands with one: its element (the
// gear crate's numbers, 0 for none), what it holds still and what it held whole. Then its type's number in the roster,
// its rank (1 Minor to 5 Boss), its faction's number, the phase it fights in (1, 2 or 3), and how alert it is (0 idle,
// 1 suspicious, 2 alert, 3 searching). Then the ticks left of its Expose and its Charge, and of the immunity a Charge
// leaves after it. Then, for a companion (an officer ashore), its leader's number (0 for a foe), its officer's given
// and family names' places in content/gear/crew.json, and its officer's post (0 First Mate to 4 Lookout), which it is
// dressed by. All of it but the name below crosses `packed`, after its glance and in this order (crates/protocol/src/land.rs,
// `foe_numbers`); the fields between `id` and `packed` are kept deprecated only so the table's field numbers hold.
// Last, the name it stands under in place of its type's (absent for none), sent each time the foe is: a public
// event's Warden or Marrow, or the Fissure's growth.
table Foe {
  id: uint;
  kind: ubyte (deprecated);
  glance: [double] (deprecated);
  level: ubyte (deprecated);
  shield_element: ubyte (deprecated);
  shield: double (deprecated);
  shield_most: double (deprecated);
  type: ubyte (deprecated);
  rank: ubyte (deprecated);
  faction: ubyte (deprecated);
  phase: ubyte (deprecated);
  alert: ubyte (deprecated);
  expose: uint (deprecated);
  charge: uint (deprecated);
  charge_immune: uint (deprecated);
  leader: uint (deprecated);
  given: ubyte (deprecated);
  family: ubyte (deprecated);
  post: ubyte (deprecated);
  packed: [ubyte];
  // In a snapshot built on another that held this foe, `packed` holds only the numbers that changed since, a bit set
  // here for each; the rest stand as they stood.
  changed: [ubyte];
  name: string;
}

// Something that happened in the fight: what (as the room numbers it), how the blow was struck (0 for none), who struck
// and who was struck, how much it did, the stroke a swing came by (combat's 1 to 6, 0 for none), whether the blow was
// a crit, the element it carried (the gear's 1 to 3, 0 for none), and the fighter an Atheric's chain blow came from: the
// foe its leap leapt from or its burst burst from, the player its bite came from, on every event of that blow (0 for
// none).
table Event {
  tick: ulong;
  kind: ubyte;
  how: ubyte;
  striker: uint;
  defender: uint;
  amount: double;
  stroke: ubyte;
  crit: bool;
  element: ubyte;
  from: uint;
}

// A shot in flight, or a gun's ball in the tick it stopped: who shot it, what shot it (combat's number), where it is
// (x, y, z), how fast it goes, and the ticks it has flown. A stopped ball's last segment runs from `at` to `at` plus
// one tick of its velocity, to where it stopped, and carries `muzzle`, the point it left its gun; a ball still flying
// carries none.
table Flying {
  owner: uint;
  ranged: ubyte;
  at: [double];
  velocity: [double];
  age: ushort;
  muzzle: [double];
  // The tick a stopped ball stopped, so a page shown it once already passes it over.
  stopped: ulong;
}

// One ship as the sea room last moved it: where it is, its heading in radians clockwise from north, and the pace it
// sailed at, held down near a hostile, 0 at rest.
table Ship {
  player: uint;
  x: double;
  y: double;
  heading: double;
  pace: ushort;
}

// A friendly ship of the traffic the room has taken off its route: its traffic id, where it is, its heading in radians
// clockwise from north, and its hull (as Hostile numbers it).
table Friendly {
  traffic: ulong;
  x: double;
  y: double;
  heading: double;
  hull: ubyte;
}

// A hostile ship at sea, the Grey Tithe's: its number, where it is, its heading in radians clockwise from north, its
// faction (1 the Grey Tithe), its rank (1 Minor to 5 Boss) and the hull its rank sails (0 the Sloop, 1 the Schooner,
// 2 the Brig, 3 the Frigate; a reader that knows none reads the Sloop); then its level (0 none), the distance it is
// sighted from, metres (0 from a room that sends none), and its way at sea, metres a second at the world's own time
// (0 from a room that sends none).
table Hostile {
  id: uint;
  x: double;
  y: double;
  heading: double;
  faction: ubyte;
  rank: ubyte;
  hull: ubyte;
  level: ubyte;
  sight: double;
  way: double;
}

// A player's fight at sea as the room last stepped it, in the naval crate's numbers (crates/naval/src/wire.rs), and
// its captain's faction, rank and hull, as Hostile numbers them. Then the other captains in the fight, their count and
// each one's numbers (the number its events name it by, its faction and rank, its ship and its mind; none when
// there are none), which the view leaves out so a page that knows one captain reads it whole. Last, whether the player
// may board a captain of it now: the sea would take the boarding they asked (crates/room/src/battle.rs `alongside`).
table SeaFight {
  player: uint;
  view: [double];
  faction: ubyte;
  rank: ubyte;
  others: [double];
  hull: ubyte;
  may_board: bool;
}

// One ship in a fleet room: its number; whether a captain sails it; its helm's numbers in the sailing crate's order
// (crates/sailing/src/floats.rs) and its pose; its hull, sail and men, each with what it has of it whole; its state
// (0 afloat, 1 struck, 2 sinking, 3 sunk) and the fires aboard; its guns (the seconds each side has left
// to load, port then starboard, then how far each has loaded); its load (as Orders numbers it) and whether it is
// braced; for a captain, its mode (0 cruise, 1 engage, 2 flee, 3 struck, 4 sinking), the ship it fights (0 none) and
// its sides run out (1 port, 2 starboard, 3 both); for a player's ship, the number of its last orders taken; and the
// faction it sails for (0 a player's or a friendly ship's, else as Hostile numbers them), a captain's rank (1 Minor to 5 Boss, 0 none), and
// its hull, as Hostile numbers them.
table Vessel {
  id: uint;
  captain: bool;
  ship: [double];
  pose: [double];
  hurts: [double];
  state: ubyte;
  fires: ubyte;
  guns: [double];
  load: ubyte;
  braced: bool;
  mode: ubyte;
  target: uint;
  run_out: ubyte;
  acknowledged: uint;
  faction: ubyte;
  rank: ubyte;
  hull: ubyte;
}

// A ball aloft in a fleet room: the ship that fired it, where it leaves its gun and when (seconds of the fight's
// clock), its launch velocity, and its radius. It flies by its closed form: at t seconds it is start plus launch times
// t, less half of 9.81 m/s² times t squared upward.
table Ball {
  shooter: uint;
  start: [double];
  launch: [double];
  born: double;
  radius: double;
}

// Something that happened in a fleet room's fight, with its tick: what (1 a ball leaves its gun, 2 a ball strikes a
// ship, 3 splashes, 4 lands, 5 a captain runs out a side, 6 a ship's state changes, 7 a player's guns refuse, 8 a
// ship's sails will not set, 9 a ship takes a load, 10 a captain leaves the fight, 11 a player's stem rams a ship); the
// ship it happened to (for a ball, the one that fired it, for a strike or a ram the one struck) and, for a strike or a
// ram, who struck; a number saying more (a strike's zone, 0 hull, 1 holed, 2 canvas; a side, 0 port, 1 starboard; a
// state as Vessel numbers it; why guns refuse, 0 no side bears, 1 silent, 2 braced, 3 loading; a load as Orders numbers
// it; how a captain left, 0 sunk, 1 sailed off); the side still loading; a point, and a ball's
// launch; and the seconds that side has left to load, or the hull a ram took.
table Naval {
  tick: ulong;
  kind: ubyte;
  ship: uint;
  by: uint;
  detail: ubyte;
  side: ubyte;
  point: [double];
  launch: [double];
  left: double;
}

// A spell every player sees: its number in the room; its kind (its spell's number among the Arts', 1 Tempest's orb to
// 9 Vanish's veil, 10 a Duskraven's bolt); the player who cast it; its Art (1 Storm, 2 Divine, 3 Shadow); where it is
// (x, y, z); where it heads (a Dawnflare's end, Arc Lash's reach ahead; none for the rest); the foe it seeks (0 none);
// the ticks it has lasted and its whole life in ticks; and how far it reaches (a ring's or a well's radius, a cone's
// length).
table Spell {
  id: uint;
  kind: ubyte;
  caster: uint;
  art: ubyte;
  at: [double];
  heads: [double];
  seeks: uint;
  age: uint;
  life: uint;
  radius: double;
}

// Something of a zone's public event the page draws: what (1 the fissure, 2 its growth, 3 a store, 4 a shard on the
// ground, 5 a shard carried, its id its carrier's, 6 the tithe-taker, its id his foe's, 7 a banner, 8 the raiders'
// approach), its number, where it is (x, y, z), its health 0 to 1 (the growth's and a store's; the fissure's how far
// open; a shard's life left; the tithe-taker's), and its state (the growth: 1 rising, 2 standing, 3 sinking, 4
// broken; a store: 1 whole, 2 plundered; the tithe-taker: 1 arriving, 2 counting, 3 leaving). A struct, laid in its
// list as it is, each in 24 bytes: a snapshot carries dozens of them sixty times a second.
struct PublicMark {
  x: float;
  y: float;
  z: float;
  health: float;
  id: uint;
  kind: ubyte;
  state: ubyte;
}

// A zone's public events: the one running or showing its result (1 the Fissure, 2 the Grey Tithe's raid, 0 none),
// its phase (0 waiting, 1 running, 2 won, 3 failed), its ground's middle (x, y, z) and radius, and its countdown (its
// result's time left once won or failed), in ticks; the next's kind, ground and the ticks until it starts, good to
// the minute; its stage of how many (the Fissure: 1 sealing, 2 the Warden; the raid: its wave); its progress toward
// what it needs (the Fissure: shards set of shards needed; the raid: the stores' health left per mille of 1000); its
// heroic task (0 not yet offered, 1 offered, 2 met, 3 missed) and the ticks left of its window; whether its bonus
// still holds or was met; its marks; and the ticks until a raid's next wave comes in (0 while none is on its way).
table PublicEvent {
  kind: ubyte;
  phase: ubyte;
  ground: [double];
  radius: double;
  ticks_left: uint;
  next_kind: ubyte;
  next_ground: [double];
  next_ticks: uint;
  stage: ubyte;
  stages: ubyte;
  progress: ushort;
  needed: ushort;
  heroic: ubyte;
  heroic_ticks: uint;
  bonus: bool;
  marks: [PublicMark];
  next_wave_ticks: uint;
}

// One of an Elite Dungeon's seals: its kind (1 the Litany, 2 the Weighing, 3 the Ascent, 4 the Holdfast), its state
// (0 waiting, 1 running, 2 broken), its progress per mille, its pieces' marks (a Litany's runes 0 dark, 1 showing, 2
// stepped in order, 3 stepped wrong a moment ago; a Weighing's plates in play and a Holdfast's ring 1 while stood on;
// an Ascent's players on its stone and the living players in its room), and its relic's strength per mille.
table SealSeen {
  kind: ubyte;
  state: ubyte;
  progress: ushort;
  marks: [ubyte];
  relic: ushort;
}

// An Elite Dungeon's encounters: each seal in walk order; whether its Boss has woken, and its number while it stands
// (0 for none); the ward up (0 none, 1 at two thirds, 2 at one third) and how many are broken; each anchor's progress
// per mille; the ticks until a Reckoning lands while one is shown (0 for none) and the anchor it is shown at; Fury's
// step (each a tenth more on its company's blows); the ticks until Fury begins while its clock runs (0 before and
// after); and the ticks until the warded Boss's slam lands while it is shown (0 for none).
table EncounterSeen {
  seals: [SealSeen];
  woken: bool;
  boss: uint;
  ward: ubyte;
  wards_broken: ubyte;
  anchors: [ushort];
  reckoning_ticks: uint;
  reckoning_at: ubyte;
  fury: ubyte;
  fury_ticks: uint;
  slam_ticks: uint;
}

// A company inside a Breach's run, as its gate in the patrol zone shows the zone: the name of its first player in,
// its tier (0 Normal, 1 Hard) and the encounter it is on.
table BreachInside {
  name: string;
  tier: ubyte;
  encounter: ubyte;
}

// A Breach, sent whole in each snapshot to every player in its room (room::breach::seen::BreachSeen, which says
// each field): in its run, each encounter's phase (0 waiting, 1 running, 2 won), the stage reached, the seals open (a
// bit each), the revives left (-1 none counted), the Lodestone (0 away, 1 on a plinth, 2 borne, 3 lying; its bearer,
// where it stands, its charge and Hold True's share left per mille, the ticks before the company is unwritten while it
// lies), the Rewritten and their ticks left, the raisings (raiser and raised in pairs, each one's share), the hidden
// chests open, and the encounter under way; at its gate, the Waking, who the gate is open to and the companies inside.
// Ticks count down to a moment, 0 for none coming.
table BreachSeen {
  gate: bool;
  tier: ubyte;
  phases: [ubyte];
  reached: ubyte;
  seals: ubyte;
  revives: byte = -1;
  stone: ubyte;
  bearer: uint;
  stone_at: [float];
  charge: ushort;
  held: ushort;
  lying_ticks: uint;
  marked: [uint];
  mark_ticks: [uint];
  raising: [uint];
  raised: [ushort];
  chests: ubyte;
  encounter: ubyte;
  stage: ubyte;
  stage_ticks: uint;
  counts: [ubyte];
  bells: [ubyte];
  bell_foes: [uint];
  broken: ubyte;
  ring_ticks: uint;
  font_ticks: uint;
  boss: uint;
  warded: bool;
  desk: ubyte;
  marked_desk: byte = -1;
  desk_ticks: uint;
  write_ticks: uint;
  seen: bool;
  wipe_ticks: uint;
  rifts: [ubyte];
  rift_held: [ushort];
  kept: ubyte;
  takings: ubyte;
  taking_ticks: uint;
  away_shore: byte = -1;
  away: [uint];
  way_back: bool;
  bare_ticks: uint;
  held_by: bool;
  fill: ushort;
  woken: bool;
  claims: ubyte;
  open_to: [uint];
  inside: [BreachInside];
  holders: [uint];
}

// Every player in the room after one of its ticks, the dresses that changed since the last snapshot, every foe, what
// happened in the fight since the last snapshot, and the shots in flight; in the sea room, every ship at sea, every
// hostile, each player's fight, and as `players` each player off the helm, their fighter only their body on their ship's
// deck in its own frame (x to its starboard, y to its stern, z over its waterline); in a fleet room, every ship, the
// balls aloft, what happened in its fight since the last snapshot, and the fight's clock. Then every spell in a room on
// land; and at sea what floats for each player, each player's ship's kept hurts, what each player is told this tick,
// and each deck boarded; and in a fleet room the world time its clock started at, seconds since the Unix epoch, which
// sets its weather. Then, at sea, the islands the player sees or has found. Then, in a zone that holds them, its
// public events, sent whole in each snapshot; last, in an Elite Dungeon, its encounters.
table Snapshot {
  tick: ulong;
  players: [Seen];
  dressed: [Dressed];
  foes: [Foe];
  events: [Event];
  shots: [Flying];
  ships: [Ship];
  hostiles: [Hostile];
  fights: [SeaFight];
  vessels: [Vessel];
  balls: [Ball];
  naval: [Naval];
  fight_clock: double;
  spells: [Spell];
  flotsam: [Flotsam];
  kept: [Kept];
  told: [Told];
  decks: [Deck];
  world_start: double;
  islands: [Isle];
  // On land, sent to one player: what changed since the snapshot of tick `base` their screen showed (0 for none, all
  // of it): the players and foes that changed, those gone since, and what happened since it (each event, dress and
  // stopped ball once more until a later snapshot is shown). Those that did not change stand as they stood then.
  base: ulong;
  gone_players: [uint];
  gone_foes: [uint];
  // The room's middle (x, y) that everyone's packed numbers are measured from (crates/protocol/src/pack.rs).
  middle: [double];
  // In a dungeon's room, its cache beside the farthest post: x, y, z, the way it faces (radians clockwise from
  // north), and 1 while it stands open or 0 while it is shut. Empty in any other room.
  cache: [double];
  // In an Abyss run, the revives its company has left; -1 in any other room.
  revives: byte = -1;
  public_event: PublicEvent;
  // On land, the plates that changed since the snapshot the screen showed, as dresses are sent.
  plates: [Plate];
  // At sea, each traffic id the room has taken off its route, which the page draws no more, and those of its friendly
  // ships the room keeps at sea.
  taken: [ulong];
  friendlies: [Friendly];
  // In an Elite Dungeon's room, its encounters, sent whole in each snapshot; none in any other room.
  encounter: EncounterSeen;
  // In a Breach's run or a patrol room with a Breach's gate, the Breach (BreachSeen); none in any other room.
  breach: BreachSeen;
}

// What a room sends: exactly one of these is present.
table FromRoom {
  joined: Joined;
  snapshot: Snapshot;
  gear: Gear;
}

root_type FromRoom;
