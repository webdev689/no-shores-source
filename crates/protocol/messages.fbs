// Every message between a browser and a room, defined once: flatc makes the Rust and the TypeScript from this file.
// A body and controls cross as the movement crate's numbers, in its order (crates/movement/src/floats.rs), the same
// order the browser's WebAssembly door uses.

namespace overlook.wire;

// A browser's controls for one tick: forward, sideways, yaw, run, jump, crouch, mounted. Numbered 1, 2, 3 and so on.
// With them, what the player's figure shows on their own screen (the forge's move, its frame, the way it faces), and
// their dress, as the browser writes it, only when it changed. Then the fight's buttons (the stroke a swing would take,
// 0 for none and 1 to 6 as combat numbers them; guard, dodge and shoot held; the look's pitch), what the hands hold as
// combat's arms code, the room tick of the last snapshot the screen showed, and a foe's kind to stand before the player
// (0 none; 255 sends every foe away). New fields go at the end, so old readers skip them.
table Input {
  sequence: uint;
  controls: [double];
  anim: string;
  frame: ushort;
  facing: double;
  dress: string;
  combat: [double];
  arms: uint;
  seen: ulong;
  spawn: ubyte;
}

// A player's dress, passed on as their browser wrote it.
table Dressed {
  player: uint;
  dress: string;
}

// The room's welcome: the joining player's number, and everyone's dress so far.
table Joined {
  player: uint;
  dressed: [Dressed];
}

// One player as the room last stepped them: the number of their last input it took, what their figure showed with
// it, and their whole fighter in combat's order (crates/combat/src/floats.rs), whose first 22 numbers are its body.
table Seen {
  player: uint;
  acknowledged: uint;
  body: [double] (deprecated);
  anim: string;
  frame: ushort;
  facing: double;
  fighter: [double];
}

// A foe as the room last stepped it: its number, its kind, and a glance at its fighter (combat's glance order).
table Foe {
  id: uint;
  kind: ubyte;
  glance: [double];
}

// Something that happened in the fight: what (as the room numbers it), how the blow was struck (0 for none), who struck
// and who was struck, and how much it did.
table Event {
  tick: ulong;
  kind: ubyte;
  how: ubyte;
  striker: uint;
  defender: uint;
  amount: double;
}

// A shot in flight: who shot it, what shot it (combat's number), where it is (x, y, z) and how fast it goes.
table Flying {
  owner: uint;
  ranged: ubyte;
  at: [double];
  velocity: [double];
}

// Every player in the room after one of its ticks, the dresses that changed since the last snapshot, every foe, what
// happened in the fight since the last snapshot, and the shots in flight.
table Snapshot {
  tick: ulong;
  players: [Seen];
  dressed: [Dressed];
  foes: [Foe];
  events: [Event];
  shots: [Flying];
}

// What a room sends: exactly one of these is present.
table FromRoom {
  joined: Joined;
  snapshot: Snapshot;
}

root_type FromRoom;
