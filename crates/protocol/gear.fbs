// A player's gear on the wire, sent to them alone (`Gear`, in `FromRoom` of `messages.fbs`): their items, Vestiges,
// drops, crew and ship. Its own file beside the rooms' messages, which include it.
namespace overlook.wire;

// One column of an item's nodes: what it holds (0 an upgrade, 1 handling, 2 finish, 3 perks, 4 an Atheric's own), the
// traits it offers by id, the XP that unlocks it, and what a node of it costs in Aurem, fragments, Essence and the
// item's island resource.
table GearColumn {
  kind: ubyte;
  traits: [string];
  xp: uint;
  aurem: uint;
  fragments: ushort;
  essence: ushort;
  resource: ushort;
}

// An item a player holds, as their own gear message tells them: their number for it, its kind and rarity (the gear
// crate's numbers), its level, the named item it is (empty for a rolled one) or a rolled one's name among its kind's,
// its island resource (255 for none), whether a Breach's, its XP and the most it earns, the nodes bought (a bit each)
// and the one chosen in each column (255 none), the slot it is carried with, where it is (0 carried, 1 the vault, 2
// and on worn in the slot that many less 2), its Attack, Defense and Prestige, its columns, its price at a vendor, and
// a weapon's element (the gear crate's numbers, 0 for none).
table GearItem {
  id: uint;
  kind: ubyte;
  rarity: ubyte;
  level: ubyte;
  named: string;
  name: ubyte;
  resource: ubyte;
  breach: bool;
  xp: uint;
  xp_most: uint;
  bought: uint;
  chosen: [ubyte];
  bucket: ubyte;
  at: ubyte;
  attack: uint;
  defense: uint;
  prestige: uint;
  columns: [GearColumn];
  price: uint;
  element: ubyte;
}

// A Vestige a player holds: their number for it, its colour, the slot it holds an item for, that item's level, and
// whether it is in the vault.
table GearVestige {
  id: uint;
  rarity: ubyte;
  slot: ubyte;
  level: ubyte;
  vaulted: bool;
}

// A drop lying on the ground for this player alone: their number for it, a Vestige's colour and slot, and where it
// lies (x, y, z); then what it is (0 a Vestige, 1 an Ammo box, 2 an Ammo crate), where it was thrown from (x, y, z)
// and how many ticks it has still to fly before it rests.
table GearDrop {
  id: uint;
  rarity: ubyte;
  slot: ubyte;
  at: [double];
  kind: ubyte;
  from: [double];
  flying: ubyte;
}

// A bounty of the day's board as it stands for a player: its words, how many it asks, how many they have counted,
// whether they hold it and whether they turned it in.
table GearBounty {
  words: string;
  target: uint;
  count: uint;
  held: bool;
  paid: bool;
  // Where it counts, by the board's pools: 0 on land, 1 at sea, 2 in dungeons.
  pool: ubyte;
  // Its short name, as its card heads it.
  name: string;
}

// A quest a player holds, story mission or side quest: its id in content/gear/quests.json, the step its count stands
// at (from 0), and whether every step is done, waiting to be finished.
table GearQuest {
  id: string;
  step: ubyte;
  done: bool;
}

// A player's own gear, sent to them alone whenever it changes: their XP, level, Prestige and Defense; their Aurem,
// then their Weapon and Armor Fragments, Weapon and Armor Essence and Fruit of Dagon, and each island's resource in
// the catalogue's order; their items, Vestiges and those lying for them; the room's resource nodes they have spent (on
// a sea island, the wrecks they have scavenged); whether they stand where a Vestige opens (the Mage's counter, or the
// stall); and the answer to their last ask (0 done, then the gear crate's refusals by number) with the item a Vestige last opened to (0 none) and how many asks have been
// answered; and the resource nodes standing that they may still gather, four numbers each: its number, x, y and its
// island's resource; and in a social space, the vendors' wares of the day, the Armorsmith's, the Weaponsmith's then
// the Shipwright's, each numbered by its place among its vendor's and priced in Aurem.
table Gear {
  xp: ulong;
  level: ubyte;
  prestige: uint;
  defense: uint;
  aurem: uint;
  stocks: [ushort];
  resources: [ushort];
  items: [GearItem];
  vestiges: [GearVestige];
  drops: [GearDrop];
  spent: [ubyte];
  at_mage: bool;
  answer: ubyte;
  identified: uint;
  answered: uint;
  nodes: [double];
  wares: [GearItem];
  // What their worn gear trims of the fight's numbers (combat's Trim, in its order): their fighter in a snapshot
  // leaves it out, and their browser puts it back before it predicts them.
  trim: [double];
  // How far to their next level, 0 to 1, and what it still takes: XP below level 20, Prestige past it.
  to_next: double;
  to_next_needs: uint;
  // How far their next Fruit of Dagon has grown, 0 to 1; below 0 until their XP reaches level 20's.
  fruit_growing: double = -1;
  // The arms the room lets them take up, by combat's codes: their gear's, and with a torch where the main hand
  // leaves the left free. The room makes any other bare hands.
  arms: [uint];
  // The emblems they keep and the one they wear, by their place in content/gear/emblems.json; and in a social space,
  // the emblems the Tailor sells that day.
  emblems: [ushort];
  emblem: ushort;
  emblems_sold: [ushort];
  // The Art they wear (1 Storm, 2 Divine, 3 Shadow); each Art's Core, three slots an Art in the Arts' order, each its
  // fragment's place in its Art's list (255 none); how far their Anima has charged, and each Tenet recharged, 0 to 1
  // (1 ready), as the room's tick that sent them had it.
  art: ubyte;
  cores: [ubyte];
  anima: double;
  tenets: [double];
  // The Ranged loadout's ammunition: the shots left in the one worn and its capacity (0 with none worn), and the share
  // of a full capacity kept, 0 to 1, which any Ranged weapon worn holds. Then the Ammo crates carried, and in a social
  // space the Weaponsmith's price for one (0 elsewhere).
  ammo: ushort;
  ammo_most: ushort;
  ammo_share: double;
  crates: ubyte;
  crate_price: uint;
  ship: GearShip;
  // Where they stand with the factions: the one pledged to (0 none), and for each faction in content/gear/factions.json's
  // order the reputation earned with it and the packages it holds for them.
  pledge: ubyte;
  reputation: [ulong];
  packages: [uint];
  // Each Art's level, its XP toward the next, and the fragments it owns, one bit each by place, in the Arts' order.
  art_levels: [ubyte];
  art_xp: [uint];
  art_owned: [ubyte];
  // The cosmetics they keep and the dye, coat and barding they wear, by their place in content/gear/cosmetics.json;
  // and in a social space, those the Tailor and the Tack sell that day.
  cosmetics: [ushort];
  dye: ushort;
  coat: ushort;
  barding: ushort;
  cosmetics_sold: [ushort];
  // Their Shapes; and while Shape is in their social space, his place among its spots (255 while he is away) and
  // his wares of the week, each numbered by its place among them and priced in Shapes.
  shapes: ushort;
  shape_place: ubyte = 255;
  shape_wares: [GearItem];
  // In a social space, every faction's wares in the factions' order, each numbered by its place among its faction's
  // and priced in Aurem: its cape, its armour and its weapons, as the room makes them.
  faction_wares: [GearItem];
  // The clock's day the room's word is of (`gear::clock::day_of`, each beginning at 09:00 UTC): the smiths' wares it
  // shows are that day's, and a smith's ware is asked by it, so none sent as the day turns buys the next day's. An
  // ask about the bounty board sends it back too.
  day: uint;
  // In a patrol, the entrances of its dungeons, five numbers each in the dungeons' order: x, y, the ground's height
  // there, the model's yaw (radians clockwise from north, turning its +z as an RMB block's yaw does), and which of
  // the four entrance models it is (0 to 3).
  dungeons: [double];
  // Whether they have finished the prologue, as kept with their character. A room that writes no word of it (one built
  // before it was said) reads as past it, as a save with no story does.
  prologue_done: bool = true;
  // Their day's and week's record as kept with their character (gear's Activity): the day it is for and the tiers of
  // the dungeon of the day cleared then (0 Normal, 1 Elite, 2 Abyss); the week it is for, whether they cleared the
  // Elite and the Abyss Dungeon of the week, and whether they hold the Abyss boon. The page judges each by its own day.
  activity_day: uint;
  cleared: [ubyte];
  activity_week: uint;
  week_elite: bool;
  week_abyss: bool;
  boon: bool;
  // The day's six bounties on the board, in its order, as they stand for them (none held from another day); and what
  // each pays them when turned in, at their level.
  bounties: [GearBounty];
  bounty_xp: uint;
  bounty_aurem: uint;
  // The quests they hold that the content still has, in the order written, each at the step it stands at.
  quests: [GearQuest];
}

// A named officer: their number, post (0 First Mate, 1 Gunner, 2 Bosun, 3 Carpenter, 4 Lookout), grade (a rarity),
// names by their places in content/gear/crew.json, duty (0 aboard, 1 at their post, 2 ashore), level and how far to
// the next, service and its most, how well they hold their post, their nodes as an item's (each column's XP their
// service's), and an offer's wage.
table GearOfficer {
  id: uint;
  post: ubyte;
  grade: ubyte;
  given: ubyte;
  family: ubyte;
  duty: ubyte;
  level: ubyte;
  to_next: double;
  trained: uint;
  trained_most: uint;
  strength: double;
  bought: uint;
  chosen: [ubyte];
  columns: [GearColumn];
  wage: uint;
}

// The ship's own power and crew: its experience, level, Prestige, Attack and Defense and how far to its next level;
// Timber, Canvas, Iron and Heartwood; its hands and its complement; its officers, and at a pledged faction's counter
// the officers of the day; its trim at sea (the gear crate's ShipTrim, in its order); and the pledge.
table GearShip {
  xp: ulong;
  level: ubyte;
  prestige: uint;
  attack: uint;
  defense: uint;
  to_next: double;
  to_next_needs: uint;
  stocks: [ushort];
  hands: ushort;
  hands_most: ushort;
  officers: [GearOfficer];
  offers: [GearOfficer];
  trim: [double];
  // The faction the player is pledged to (0 none), whose counter signs officers on.
  pledge: ubyte;
}
