// The website and the game at noshores.online: a Worker of static files alone, the site's pages at its root and the
// game's client under /play/, gathered into target/served by .github/workflows/site.yml before it deploys. Its domains
// are given by that deploy, once noshores.online is a zone of the Cloudflare account, so it has no workers.dev address.
{
  "name": "noshores-site",
  "compatibility_date": "2026-11-01",
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  // `/world` is answered as `/world/`, as the pages' links name them.
  "assets": { "directory": "../target/served", "html_handling": "auto-trailing-slash" },
}
