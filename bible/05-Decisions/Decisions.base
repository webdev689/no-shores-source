filters:
  and:
    - file.inFolder("05-Decisions")
views:
  - type: table
    name: Decisions
    filters:
      and:
        - type == "decision"
    order:
      - file.name
      - date
      - status
    sort:
      - property: date
        direction: DESC
  - type: table
    name: Claude's calls
    filters:
      and:
        - type == "claude-calls"
    order:
      - file.name
      - date
      - status
    sort:
      - property: date
        direction: DESC
