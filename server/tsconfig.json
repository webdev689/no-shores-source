{
  // The server's Cloudflare shell: strict like the client, with Cloudflare's Workers types instead of the DOM's.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["*.ts", "accounts/*.ts"],
  "exclude": ["*.test.ts", "*ForTests.ts", "accounts/*.test.ts", "accounts/*ForTests.ts"]
}
