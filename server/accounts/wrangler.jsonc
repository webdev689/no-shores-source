// The Cloudflare Worker that keeps the accounts, their sessions and their characters, over D1. `npm run accounts`
// runs it here, beside `npm run server`; the rooms reach its CharacterKeeper through their service binding, and the
// Discord bot its LinkedCharacters through its own.
{
  "name": "overlook-accounts",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "send_metrics": false,
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "overlook-accounts",
      // CI writes the real database's id here in its own copy before it deploys (.github/workflows/rooms.yml).
      "database_id": "set-by-the-deploy",
      "migrations_dir": "migrations",
    },
  ],
  // Find a Company (finder.ts): one Durable Object for each dungeon a run is found for, reached by WebSocket; and the
  // chat's one hall (chat.ts).
  "durable_objects": {
    "bindings": [
      { "name": "FINDERS", "class_name": "CompanyFinder" },
      { "name": "CHATS", "class_name": "ChatHall" },
    ],
  },
  "migrations": [
    { "tag": "finders", "new_sqlite_classes": ["CompanyFinder"] },
    { "tag": "chat", "new_sqlite_classes": ["ChatHall"] },
  ],
  // Sign-ins counted by address before the database or a password's hash is reached (accounts.ts, "POST /v1/login"):
  // ten a minute in each of Cloudflare's locations. Its namespace is a number of our own, unique in the Cloudflare
  // account: nothing is made in the dashboard.
  "ratelimits": [{ "name": "SIGN_INS", "namespace_id": "4401", "simple": { "limit": 10, "period": 60 } }],
  // The bot's Members (bot/main.ts), which says who is a developer, reached by RPC alone.
  "services": [{ "binding": "BOT", "service": "noshores-bot", "entrypoint": "Members" }],
  // The pages a Discord sign-in may come back to, by origin and path: the game at noshores.online and on GitHub Pages,
  // where it is still published. `npm run accounts` gives the dev server's own.
  "vars": {
    "PAGES": "https://noshores.online/play/ https://www.noshores.online/play/ https://lattymoy.github.io/no-shores-source/",
  },
}
