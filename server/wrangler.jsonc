// The Cloudflare Worker that hosts the rooms: one Durable Object for each room's name. `npm run server` runs it here.
{
  "name": "overlook-rooms",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "send_metrics": false,
  // Players reach the rooms at the account's workers.dev address; each version's own preview address is not used.
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomHost" }],
  },
  "migrations": [{ "tag": "rooms", "new_sqlite_classes": ["RoomHost"] }],
  // The accounts' keeper of characters (accounts/wrangler.jsonc), reached by RPC alone.
  "services": [{ "binding": "ACCOUNTS", "service": "overlook-accounts", "entrypoint": "CharacterKeeper" }],
  // The bake's node files, which `npm run bake` writes before the Worker runs or is bundled. Each node's room reads
  // only its own; every request goes to the Worker first, so none is served to a browser.
  "assets": { "directory": "../generated/nodes", "binding": "NODES", "run_worker_first": true },
}
